# Copy to sandbox/.env and fill in. sandbox/.env is gitignored.

# Your SSH *public* key, one line (contents of e.g. ~/.ssh/id_ed25519.pub).
# Used for key-only login as the 'sandbox' user. If empty, SSH login is
# disabled and you must use: docker exec -it -u sandbox kronos-sandbox bash
SANDBOX_SSH_PUBKEY=

# Egress firewall. 1 = block the local network (recommended). 0 = disable
# (unsafe; only for debugging on a trusted network).
SANDBOX_FIREWALL=1
