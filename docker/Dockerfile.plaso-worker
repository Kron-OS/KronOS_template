# syntax=docker/dockerfile:1
# Plaso-capable variant of docker/Dockerfile: same app image, same venv, PLUS
# Plaso installed in that venv so the q.parse.plaso Celery consumer can
# actually exec kronos-plaso-worker.py via FirecrackerLauncher's subprocess
# path. This is still the dev-simplification (plain subprocess, not real
# Firecracker/gVisor microVM isolation) documented in
# src/external/sandbox/firecracker.py's own docstring — out of scope here.
#
# ALSO carries volatility3==2.28.0 (roadmap E5, VolatilityModule/
# VolatilityLauncher): both HEAVY parsers share the q.parse.plaso queue (see
# celery_app.py -- ParserType.HEAVY always routes there regardless of which
# parser produced it, already true for ZipArchiveParser/TarArchiveParser
# before this), so whichever container consumes that queue needs every
# HEAVY parser's real external tool on PATH. volatility3's own base install
# is a ~1.4 MB wheel plus `pefile` (verified: `pip install volatility3==2.28.0`
# pulls in nothing else for the plugins this module uses -- see
# poc/volatility_memory_module/README.md) -- light enough to share this image
# rather than needing its own Dockerfile variant the way Plaso's much heavier
# dependency set does.
#
# pycryptodome (Milestone GGGGG): volatility3's own registry.hashdump/
# lsadump/cachedump plugins `try: from Crypto.Cipher import ...` (real,
# confirmed against the real installed package source, not guessed) --
# without it those three plugins fail to even import (real, live-confirmed
# ModuleNotFoundError, named as a known gap in Milestone CCCCC's own doc).
# Version constraint matches volatility3==2.28.0's own declared `extra ==
# "full"` optional dependency (`pycryptodome<4,>=3.21.0`, confirmed via
# `importlib.metadata.distribution("volatility3").requires`) rather than an
# unpinned `latest`.
FROM cgr.dev/chainguard/python:latest-dev AS builder

USER root

WORKDIR /app
COPY pyproject.toml .
COPY src/ ./src/
COPY kronos_attest/ ./kronos_attest/

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir . \
    && /opt/venv/bin/pip install --no-cache-dir plaso==20260512 \
    && /opt/venv/bin/pip install --no-cache-dir volatility3==2.28.0 \
    && /opt/venv/bin/pip install --no-cache-dir 'pycryptodome>=3.21.0,<4'

RUN mkdir -p /var/log/kronos && touch /var/log/kronos/.keep

FROM cgr.dev/chainguard/python:latest

WORKDIR /app

COPY --from=builder --chown=nonroot:nonroot /opt/venv /opt/venv
COPY --chown=nonroot:nonroot src/ ./src/
COPY --chown=nonroot:nonroot kronos_attest/ ./kronos_attest/
COPY --chown=nonroot:nonroot pyproject.toml .
COPY --chown=nonroot:nonroot docker/plaso/kronos-plaso-worker.py ./plaso-worker/kronos-plaso-worker.py
# Real, reproduced gap left by roadmap E4 (never fixed): this Dockerfile never
# COPYs docker/yara/kronos-yarax-worker.py in, so YaraXSandboxRunner's default
# worker_path resolves to a path that doesn't exist inside this specific
# image (silently disabled, not crashing -- see get_parser_registry's
# _yara_runner wiring). Not fixed here (out of scope for this item, and
# fixing it deserves its own real container-level PoC re-run per CLAUDE.md
# §F rather than a drive-by one-line change) -- flagged again so the next
# pass doesn't have to rediscover it.
COPY --chown=nonroot:nonroot docker/volatility/kronos-volatility-worker.py ./volatility-worker/kronos-volatility-worker.py

COPY --from=builder --chown=nonroot:nonroot /var/log/kronos /var/log/kronos

ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PLASO_WORKER_PATH=/app/plaso-worker/kronos-plaso-worker.py
ENV VOLATILITY_WORKER_PATH=/app/volatility-worker/kronos-volatility-worker.py

USER nonroot

ENTRYPOINT []

CMD ["celery", "-A", "src.external.celery_app", "worker", "-Q", "q.parse.plaso", "-c", "1", "--loglevel=info"]
