# KronOS environment variables — copy to .env and fill in production values
# NEVER commit the actual .env file

# Database
POSTGRES_DB=kronos
POSTGRES_USER=kronos
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://kronos:changeme_in_production@postgres:5432/kronos

# Redis
REDIS_PASSWORD=changeme_in_production
REDIS_URL=redis://:changeme_in_production@redis:6379/0

# MinIO / S3 object storage
MINIO_ROOT_USER=kronos_minio
MINIO_ROOT_PASSWORD=changeme_in_production
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=kronos_minio
MINIO_SECRET_KEY=changeme_in_production
# Browser-facing host:port used only to SIGN presigned evidence upload URLs
# (SigV4 signs the Host header, so it must match what the browser will
# actually request). Must be reachable from wherever end users' browsers
# run — e.g. a public MinIO ingress hostname. Left as minio:9000 (internal),
# evidence upload will fail outside the compose network.
MINIO_PUBLIC_ENDPOINT=minio:9000

# OpenSearch
OPENSEARCH_URL=http://opensearch:9200
# Browser-facing OpenSearch Dashboards origin for the Timeline tab's iframe
# embed (e.g. https://os.kronos.example). Leave unset/empty to disable the
# feature — no OpenSearch Dashboards service is deployed by
# docker-compose.prod.yml by default.
OPENSEARCH_DASHBOARDS_URL=

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_in_production
KEYCLOAK_HOSTNAME=keycloak.kronos.example
KEYCLOAK_ISSUER=http://keycloak:8080/realms/kronos
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/kronos/protocol/openid-connect/certs

# nginx CSP allowances — browser-facing origins for services published
# directly to end users (not proxied through nginx's /api/ etc.). Leave
# empty to omit that origin from the CSP header entirely.
BACKEND_PUBLIC_URL=
MINIO_PUBLIC_URL=

# Vault / KMS
VAULT_TOKEN=changeme_in_production
VAULT_ADDR=http://vault:8200

# Application
KRONOS_SECRET_KEY=changeme_in_production_must_be_32_bytes_min
KRONOS_ENV=production

# RFC 3161 Timestamping
TSA_URL=http://tsa:318

# ClamAV
CLAMD_HOST=clamav
CLAMD_PORT=3310

# --------------------------------------------------------------------------
# SIEM/SOAR outbound sink connectors (roadmap Milestones R2-R4) and inbound
# Microsoft Defender poll source (Q4). Every one of these is optional --
# leaving a connector's vars unset (or empty) is the honest, supported
# "this deployment doesn't push to / poll that vendor" state
# (configure_*_from_settings() in src/external/dependencies.py checks for
# exactly this and no-ops rather than failing). Names below match
# src/config.py's Settings field names 1:1 (case-insensitive env lookup) --
# verified against that file directly (2026-08-09, Milestone S) to avoid
# the kind of dev/prod name-drift the closed roadmap's I3 item found for
# ClamAV. None of these are wired into docker-compose.dev.yml's own
# environment blocks (kronos-backend/celery-worker there) -- there is no
# real free/self-hostable Splunk-Enterprise-trial-class stand-in for
# Sentinel/Defender, and standing up a fake receiver in the shared dev
# stack would only re-prove what each connector's own poc/ already proved
# at test-stage (see docs/KAFKA_AND_INTEGRATIONS_ROADMAP.md Milestone S
# STATUS block). They ARE wired into docker-compose.prod.yml's
# kronos-backend/celery-worker `environment:` blocks (as
# ${VAR:-} passthroughs defaulting to unset), so a real production
# deployment only has to fill in the values below.

# Splunk HTTP Event Collector sink (R2). Both must be set together.
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=

# Generic CEF-over-syslog sink (R3), e.g. a QRadar/generic SIEM syslog
# listener. Only CEF_SYSLOG_HOST is required -- CEF_SYSLOG_PORT already
# defaults to 514 (syslog's own conventional port) in src/config.py if
# left unset; shown here so an operator can see/override it.
CEF_SYSLOG_HOST=
CEF_SYSLOG_PORT=514

# Microsoft Sentinel Logs Ingestion API sink (R4) -- OAuth2
# client-credentials against a real Entra ID app registration granted the
# target DCR's "Monitoring Metrics Publisher" role. ALL FIVE must be set
# together (Sentinel's real OAuth2 flow has no partial/anonymous mode).
SENTINEL_DCE_ENDPOINT=
SENTINEL_DCR_IMMUTABLE_ID=
SENTINEL_TENANT_ID=
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Microsoft Defender (Microsoft Graph Security API alerts_v2) poll source
# (Q4) -- OAuth2 client-credentials against a real Entra ID app
# registration granted SecurityAlert.Read.All. ALL THREE must be set
# together. Registered into the real IntegrationSourceRegistry at
# kronos-backend startup if set, but nothing in celery_app.py's
# beat_schedule yet actually calls run_poll_cycle() on a timer for it --
# a real, separate follow-up (see
# docs/KAFKA_AND_INTEGRATIONS_ROADMAP.md Milestone S STATUS block) --
# so setting these today registers the source but does not yet result in
# real periodic polling.
DEFENDER_TENANT_ID=
DEFENDER_CLIENT_ID=
DEFENDER_CLIENT_SECRET=
