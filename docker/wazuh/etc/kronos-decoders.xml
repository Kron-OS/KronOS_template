<?xml version="1.0" encoding="utf-8"?>
<decoder_list>

  <!-- ===================================================================
       KronOS Wazuh Decoders
       Three log sources forwarded via Fluent Bit:
         1. kronos-audit    — FastAPI audit log (JSON)
         2. kronos-keycloak — Keycloak event log (JSON)
         3. kronos-falco    — Falco runtime alerts (JSON)

       SOURCE OF TRUTH for field names below: the `AuditEvent` model in
       src/domain/audit.py (actor_user_id, org_id, case_id, evidence_id,
       details, ...) and the payload AuditLogService._canonical_json()/
       .log() actually construct in src/application/audit_log.py — not this
       file. Re-verify field paths against those whenever they change (see
       kronos-rules.xml's header comment for why this matters: COMP-7/16).
       =================================================================== -->

  <!-- ===================================================================
       1. KronOS Audit Log — emitted by AuditLogService
       Sample: {"timestamp":"...","event_type":"evidence.upload_requested","actor_user_id":"...","org_id":"...","evidence_id":"..."}
       (note the AuditEvent model field is `actor_user_id`, not `user_id` —
       kept as the local var alias below only so existing rule descriptions
       reading $(user_id) keep working.)

       NOTE (COMP-8 gap): AuditLogService.log()'s own structured log call
       (src/application/audit_log.py) currently only emits
       {"event_id":..., "event_type":..., "seq":...} as extras — it does
       NOT include actor_user_id/org_id/case_id/evidence_id/details in that
       specific log line today (those fields exist on the persisted
       AuditEvent row in Postgres, not yet in the JSON log stream Fluent
       Bit/Wazuh see). `endpoint` also isn't a field either the AuditEvent
       model or any current log call populates. Until the JSON logging
       pipeline (COMP-8) is wired to serialize the full AuditEvent — not
       just the audit_event_logged summary line — these vars will extract
       nothing for most events; this decoder documents the intended target
       shape so the rules above are correct once that lands. -->
  <decoder name="kronos-audit">
    <prematch>{"event_type":</prematch>
    <plugin_decoder>JSON_Decoder</plugin_decoder>
  </decoder>

  <decoder name="kronos-audit-fields">
    <parent>kronos-audit</parent>
    <use_own_name>true</use_own_name>
    <json_null_field>discard</json_null_field>
    <var name="event_type">event_type</var>
    <var name="user_id">actor_user_id</var>
    <var name="org_id">org_id</var>
    <var name="evidence_id">evidence_id</var>
    <var name="case_id">case_id</var>
    <var name="endpoint">details.endpoint</var>
    <var name="error_type">details.error_type</var>
  </decoder>

  <!-- ===================================================================
       2. Keycloak event log (login, logout, token-refresh, errors)
       Sample: {"type":"LOGIN","realmId":"...","userId":"...","clientId":"...","ipAddress":"..."}
       =================================================================== -->
  <decoder name="kronos-keycloak">
    <prematch>{"type":"</prematch>
    <plugin_decoder>JSON_Decoder</plugin_decoder>
  </decoder>

  <decoder name="kronos-keycloak-fields">
    <parent>kronos-keycloak</parent>
    <use_own_name>true</use_own_name>
    <json_null_field>discard</json_null_field>
    <var name="event_type">type</var>
    <var name="user_id">userId</var>
    <var name="client_id">clientId</var>
    <var name="ip_address">ipAddress</var>
    <var name="realm">realmId</var>
  </decoder>

  <!-- ===================================================================
       3. Falco runtime alert (container security events)
       Sample: {"output_fields":{"proc.name":"...","container.image.repository":"..."},"rule":"...","priority":"CRITICAL"}
       =================================================================== -->
  <decoder name="kronos-falco">
    <prematch>{"output_fields":</prematch>
    <plugin_decoder>JSON_Decoder</plugin_decoder>
  </decoder>

  <decoder name="kronos-falco-fields">
    <parent>kronos-falco</parent>
    <use_own_name>true</use_own_name>
    <json_null_field>discard</json_null_field>
    <var name="falco_rule">rule</var>
    <var name="falco_priority">priority</var>
    <var name="container_image">output_fields.container.image.repository</var>
    <var name="proc_name">output_fields.proc.name</var>
  </decoder>

</decoder_list>
