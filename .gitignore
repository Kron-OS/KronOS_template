__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
.env
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.sqlite3
*.db

# SSH keys — never commit private/public keypairs (e.g. sandbox access keys)
id_ed25519*
id_rsa*
*.pem

# Extracted dev step-ca root cert (regenerated fresh by tls-init on every
# `docker compose up`, see docs/lan-dev-access.md) — never a secret (it's
# a public root cert, not a key) but ephemeral, per-stack-instance output.
/kronos-dev-root-ca.crt

scripts/dev_autoresume/.state/

# Gap Audit Milestone DDD: docker-compose.prod.yml's Docker secrets are
# `file:`-based (docker/secrets/<name>.txt), matching README.md's own Path A
# deployment instructions -- real secret material, never committed. The
# directory itself (with its README explaining the convention) IS tracked.
/docker/secrets/*.txt

# Vendored Bitnami chart tarballs from `helm dependency build` -- fetched,
# regenerable dependency artifacts, not source. `Chart.lock` IS committed
# (standard Helm practice: it pins the exact resolved postgresql/
# redis-auth-streams/redis-celery versions so `helm dependency build`
# reproduces the same versions everywhere) -- only the tarballs themselves
# are ignored.
charts/kronos/charts/*.tgz
