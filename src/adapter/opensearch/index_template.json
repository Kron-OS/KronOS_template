{
  "index_patterns": ["kronos-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1
    },
    "mappings": {
      "_meta": {
        "dynamic_policy": "true (Gap Audit Milestone UUUU) -- was 'false' (see git history for the original _meta string): that policy meant any field not explicitly listed below -- including a whole other parser's own extra[] output, or any genuinely new field -- was stored in _source but silently NEVER indexed, unfilterable, with no error anywhere (confirmed live, poc/opensearch_auto_index_fields/). 'strict' was never viable either: parser `extra` fields vary per format/parser, and 'strict' REJECTS the whole document the instant any record carries an unlisted field. The real fix is 'true' PLUS the 'strings_as_keyword' catch-all dynamic_template below: every unmapped string field now auto-indexes as a real keyword field (not OpenSearch's own default text+'.keyword' multi-field split, which is what caused the ORIGINAL bug this template already fixed once -- a Sigma term query against the bare field name silently matching nothing). Explicit entries below still take precedence over the catch-all for every field this platform's own Sigma rules/queries are known to depend on -- this is additive auto-indexing, not a replacement for curating the well-known ECS taxonomy. See docs/NEXTGEN_SOC_ROADMAP.md A1/A2 and poc/opensearch_auto_index_fields/README.md."
      },
      "dynamic": true,
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "data_type": { "type": "keyword" },
        "winlog": {
          "properties": {
            "provider_name": { "type": "keyword" },
            "event_data": { "properties": {} }
          }
        },
        "cloud": {
          "properties": {
            "service": { "properties": { "name": { "type": "keyword" } } },
            "region":  { "type": "keyword" }
          }
        },
        "log": {
          "properties": {
            "file": { "properties": { "path": { "type": "keyword" } } }
          }
        },
        "event": {
          "properties": {
            "kind":     { "type": "keyword" },
            "category": { "type": "keyword" },
            "type":     { "type": "keyword" },
            "outcome":  { "type": "keyword" },
            "original": { "type": "keyword", "index": false },
            "code":     { "type": "keyword" },
            "action":   { "type": "keyword" },
            "duration": { "type": "long" }
          }
        },
        "host": {
          "properties": {
            "name": { "type": "keyword" },
            "os": {
              "properties": {
                "name": { "type": "keyword" }
              }
            }
          }
        },
        "user": {
          "properties": {
            "name": { "type": "keyword" },
            "id":   { "type": "keyword" }
          }
        },
        "process": {
          "properties": {
            "pid":             { "type": "long" },
            "name":            { "type": "keyword" },
            "executable":      { "type": "keyword" },
            "command_line":    { "type": "keyword" },
            "parent": {
              "properties": {
                "pid":          { "type": "long" },
                "name":         { "type": "keyword" },
                "executable":   { "type": "keyword" },
                "command_line": { "type": "keyword" }
              }
            }
          }
        },
        "source": {
          "properties": {
            "ip":      { "type": "ip" },
            "address": { "type": "keyword", "ignore_above": 256 },
            "port":    { "type": "long" },
            "bytes":   { "type": "long" }
          }
        },
        "destination": {
          "properties": {
            "ip":    { "type": "ip" },
            "port":  { "type": "long" },
            "bytes": { "type": "long" }
          }
        },
        "network": {
          "properties": {
            "transport": { "type": "keyword" },
            "protocol":  { "type": "keyword" }
          }
        },
        "enrichment": {
          "properties": {
            "asset": {
              "properties": {
                "asset_id":     { "type": "keyword" },
                "criticality":  { "type": "keyword" },
                "owner":        { "type": "keyword" },
                "environment":  { "type": "keyword" }
              }
            },
            "ioc": {
              "properties": {
                "matched":      { "type": "boolean" },
                "ioc_type":     { "type": "keyword" },
                "value":        { "type": "keyword" },
                "feed_name":    { "type": "keyword" },
                "confidence":   { "type": "long" },
                "description":  { "type": "text" },
                "source_ref":   { "type": "keyword" }
              }
            }
          }
        },
        "dns": {
          "properties": {
            "question": {
              "properties": {
                "name": { "type": "keyword" }
              }
            },
            "rrname": { "type": "keyword" },
            "rrtype": { "type": "keyword" },
            "type":   { "type": "keyword" }
          }
        },
        "registry": {
          "properties": {
            "path":  { "type": "keyword" },
            "key":   { "type": "keyword" },
            "value": { "type": "keyword" }
          }
        },
        "file": {
          "properties": {
            "path": { "type": "keyword" },
            "name": { "type": "keyword" },
            "size": { "type": "long" },
            "hash": {
              "properties": {
                "md5":    { "type": "keyword" },
                "sha1":   { "type": "keyword" },
                "sha256": { "type": "keyword" }
              }
            }
          }
        },
        "error": {
          "properties": {
            "code":    { "type": "keyword" },
            "message": { "type": "text" }
          }
        },
        "http": {
          "properties": {
            "hostname": { "type": "keyword" },
            "request": {
              "properties": {
                "method":   { "type": "keyword" },
                "referrer": { "type": "keyword" }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "long" },
                "body": {
                  "properties": {
                    "bytes": { "type": "long" }
                  }
                }
              }
            }
          }
        },
        "url": {
          "properties": {
            "path":   { "type": "keyword" },
            "domain": { "type": "keyword" }
          }
        },
        "user_agent": {
          "properties": {
            "original": { "type": "keyword" }
          }
        },
        "tls": {
          "properties": {
            "subject": { "type": "keyword" },
            "sni":     { "type": "keyword" }
          }
        },
        "alert": {
          "properties": {
            "signature": { "type": "keyword" },
            "category":  { "type": "keyword" },
            "severity":  { "type": "long" },
            "action":    { "type": "keyword" }
          }
        },
        "rule": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "cloudtrail": {
          "properties": {
            "request_parameters": { "type": "object", "enabled": false }
          }
        },
        "chrome": {
          "properties": {
            "title": { "type": "text" }
          }
        },
        "kronos": {
          "properties": {
            "evidence_id":       { "type": "keyword" },
            "case_id":           { "type": "keyword" },
            "org_id":            { "type": "keyword" },
            "org_alias":         { "type": "keyword" },
            "sha256":            { "type": "keyword" },
            "parser":            { "type": "keyword" },
            "parser_version":    { "type": "keyword" },
            "record_index":      { "type": "long" },
            "ingest_timestamp":  { "type": "date" },
            "source_path":       { "type": "keyword" },
            "container_sha256":  { "type": "keyword" },
            "source_id":         { "type": "keyword" },
            "batch_id":          { "type": "keyword" },
            "event_offset":      { "type": "long" }
          }
        }
      }
    }
  }
}
