# kronos.local is the sole authorized domain for this app -- see
# docs/lan-dev-access.md and frontend/src/keycloak.ts's resolveKeycloakUrl()
# for why (a real, reproduced Keycloak session-cookie bug rules out a
# localhost-specific value here, even for local dev). Requires kronos.local
# to resolve to wherever the real dev stack (docker compose) is actually
# running -- a /etc/hosts entry pointing it at that host's IP.
VITE_KEYCLOAK_URL=https://kronos.local:8443
VITE_KEYCLOAK_REALM=kronos
VITE_KEYCLOAK_CLIENT_ID=kronos-frontend
VITE_API_URL=https://kronos.local
# FE-6: expected origin of the OpenSearch Dashboards iframe embed (TimelineTab).
# When set, the backend-supplied dashboard-url's origin is checked against
# this before it's ever assigned to an iframe's src, as defense-in-depth
# against a compromised/misconfigured backend response. Optional — leave
# unset in environments where the Dashboards origin isn't fixed in advance.
VITE_OPENSEARCH_DASHBOARDS_ORIGIN=https://kronos.local:5602
