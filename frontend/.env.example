VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=kronos
VITE_KEYCLOAK_CLIENT_ID=kronos-frontend
VITE_API_URL=http://localhost:8000
# FE-6: expected origin of the OpenSearch Dashboards iframe embed (TimelineTab).
# When set, the backend-supplied dashboard-url's origin is checked against
# this before it's ever assigned to an iframe's src, as defense-in-depth
# against a compromised/misconfigured backend response. Optional — leave
# unset in environments where the Dashboards origin isn't fixed in advance.
VITE_OPENSEARCH_DASHBOARDS_ORIGIN=http://localhost:5601
